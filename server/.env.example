# Copy this file to ".env" and fill in your values.
# The real .env is gitignored and must NEVER be committed.

# --- fal.ai ---------------------------------------------------------------
# Get a key at https://fal.ai (Dashboard -> Keys).
FAL_KEY=

# A generic, original "person in a racing suit" image for the face-swap base.
# Must be a public URL the fal API can fetch.
RACING_BASE_URL=

# Optional: override the fal model id (default: fal-ai/face-swap).
# FAL_MODEL=fal-ai/face-swap

# Optional: server port (default 3000).
# PORT=3000
